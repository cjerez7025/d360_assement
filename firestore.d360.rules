rules_version = '2';

// Reglas de la base nombrada «d360» del proyecto aligndata-arcop.
// No afectan a la base (default), que es la del portal.
service cloud.firestore {
  match /databases/{database}/documents {

    // Consultores autorizados: cuentas de Google con el correo verificado y presente en esta lista.
    // Para autorizar a otra persona, agregue su correo aquí y vuelva a publicar las reglas:
    //   npx firebase-tools deploy --only firestore:d360
    function esConsultor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'carlos.jerez@aligndata.cl',
          'jerezcarlos70@gmail.com',
          'patricio.oliva@aligndata.cl',
          'ricardo.carmona@aligndata.cl'
        ];
    }

    // Foto de perfil del consultor: solo una URL https de Google (googleusercontent.com), corta y sin espacios.
    function fotoOk(f) {
      return f is string && f.size() <= 400 && f.matches('^https://[a-z0-9-]+[.]googleusercontent[.]com/[^ ]+$');
    }
    // Quién conduce la reunión / preparó los resultados: se muestra a los clientes en la barra superior.
    function consultorOk(d) {
      return !('consultor' in d)
        || (d.consultor is map
            && d.consultor.keys().hasOnly(['nombre', 'foto'])
            && d.consultor.keys().hasAll(['nombre'])
            && d.consultor.nombre is string && d.consultor.nombre.size() >= 1 && d.consultor.nombre.size() <= 80
            && (!('foto' in d.consultor) || fotoOk(d.consultor.foto)));
    }

    // ── Pizarra compartida: comentarios con autor e imágenes, por pregunta o generales ──
    // Cada comentario es un documento propio: no se puede editar (solo crear y, el consultor, borrar).
    // Las imágenes van reducidas en el propio documento (JPEG en base64, ≤ 240.000 caracteres c/u, hasta 3).
    function esIdPz(id) {
      return id.matches('^[A-Za-z0-9]{20}$');
    }
    function imagenPz(s) {
      return s is string && s.size() > 20 && s.size() <= 240000;
    }
    function imagenesPz(l) {
      return l is list && l.size() <= 3
        && (l.size() < 1 || imagenPz(l[0]))
        && (l.size() < 2 || imagenPz(l[1]))
        && (l.size() < 3 || imagenPz(l[2]));
    }
    // Documentos adjuntos (PDF, Word, Excel…): hasta 3 por comentario, 5 MB cada uno, solo de la lista de extensiones.
    // El comentario guarda los metadatos {n: nombre, t: tipo, z: bytes, p: partes}; el contenido va en partes de ≤ 700.000
    // caracteres (base64) en pizarra/{id}/partes/{indice_parte}, que se suben ANTES de crear el comentario.
    function adjuntoPz(a) {
      return a is map
        && a.keys().hasOnly(['n', 't', 'z', 'p'])
        && a.keys().hasAll(['n', 'z', 'p'])
        && a.n is string && a.n.size() >= 3 && a.n.size() <= 120
        && a.n.lower().matches('^[^/]+[.](pdf|doc|docx|xls|xlsx|ppt|pptx|odt|ods|odp|csv|txt|rtf|zip)$')
        && a.z is int && a.z > 0 && a.z <= 5242880
        && a.p is int && a.p >= 1 && a.p <= 10
        && (!('t' in a) || (a.t is string && a.t.size() <= 100));
    }
    function adjuntosPz(l) {
      return l is list && l.size() <= 3
        && (l.size() < 1 || adjuntoPz(l[0]))
        && (l.size() < 2 || adjuntoPz(l[1]))
        && (l.size() < 3 || adjuntoPz(l[2]));
    }
    function partePz(d) {
      return d.keys().hasOnly(['d']) && d.d is string && d.d.size() > 0 && d.d.size() <= 700000;
    }

    // Forma válida de un comentario nuevo. «ahora» es la hora del servidor (no se puede falsear).
    function comentarioPz(d) {
      return d.keys().hasOnly(['autor', 'rol', 'email', 'cargo', 'foto', 'qid', 'texto', 'imgs', 'adjuntos', 'creadoEn'])
        && d.keys().hasAll(['autor', 'rol', 'qid', 'texto', 'creadoEn'])
        && d.autor is string && d.autor.size() >= 1 && d.autor.size() <= 60
        && d.qid is string && d.qid.size() >= 1 && d.qid.size() <= 20
        && d.texto is string && d.texto.size() <= 2000
        && (!('cargo' in d) || (d.cargo is string && d.cargo.size() <= 60))
        && (!('foto' in d) || (d.rol == 'consultor' && fotoOk(d.foto)))
        && (!('imgs' in d) || imagenesPz(d.imgs))
        && (!('adjuntos' in d) || adjuntosPz(d.adjuntos))
        && (d.texto.size() > 0 || ('imgs' in d && d.imgs.size() > 0) || ('adjuntos' in d && d.adjuntos.size() > 0));
    }

    // Servicio contratado que ve el cliente en su enlace: solo el paquete y su estado.
    function servicioPub(d) {
      return !('servicio' in d)
        || (d.servicio is map
            && d.servicio.keys().hasOnly(['paquete', 'estado'])
            && d.servicio.keys().hasAll(['paquete', 'estado'])
            && d.servicio.paquete in ['inicia', 'evalua', 'combo', 'acompana', 'implementa']
            && d.servicio.estado in ['propuesta', 'aceptada', 'activa', 'entregada']);
    }

    // Sesiones de diagnóstico (respuestas, notas de la reunión, datos del cliente): solo consultores.
    match /sesiones/{id} {
      allow read, write: if esConsultor();

      // Pizarra de la sesión (registro permanente): solo consultores. Los comentarios que hacen los clientes durante
      // la reunión en vivo los copia aquí el propio consultor, conservando autor y hora.
      match /pizarra/{eid} {
        allow read, write: if esConsultor();

        match /partes/{pid} {
          allow read, write: if esConsultor();
        }
      }
    }

    // Resultados publicados para el cliente.
    // Se leen de a uno conociendo el token (192 bits al azar, imposible de adivinar); NO se pueden listar.
    // Contienen solo: nombre, sector, tamaño, respuestas, las notas de la reunión (el cliente las ve por decisión) y las
    // revisiones guardadas (foto de las respuestas de cada fecha, para mostrar la evolución; hasta 24).
    // Nunca el email ni el contacto del cliente.
    match /compartidos/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if esConsultor()
        && token.size() == 32
        && request.resource.data.keys().hasOnly(['perfil', 'respuestas', 'notas', 'revisiones', 'servicio', 'consultor', 'publicadoEn', 'version'])
        && consultorOk(request.resource.data)
        && servicioPub(request.resource.data)
        && (!('revisiones' in request.resource.data)
            || (request.resource.data.revisiones is list && request.resource.data.revisiones.size() <= 24));
      allow delete: if esConsultor();

      // Solicitudes del cliente para avanzar de servicio («Quiero avanzar»): no activan nada, solo avisan al consultor.
      // Las crea quien tiene el enlace (mientras exista) con su nombre y la hora del servidor; solo el consultor las lee y las borra.
      match /solicitudes/{sid} {
        allow create: if esIdPz(sid)
          && exists(/databases/$(database)/documents/compartidos/$(token))
          && request.resource.data.keys().hasOnly(['paquete', 'nombre', 'cargo', 'creadoEn'])
          && request.resource.data.keys().hasAll(['paquete', 'nombre', 'creadoEn'])
          && request.resource.data.paquete in ['evalua', 'acompana', 'implementa']
          && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 60
          && (!('cargo' in request.resource.data) || (request.resource.data.cargo is string && request.resource.data.cargo.size() <= 60))
          && request.resource.data.creadoEn == request.time;
        allow get, list, delete: if esConsultor();
      }

      // Copia publicada de la pizarra: el cliente la ve en sus resultados. Se lee conociendo el token del enlace
      // (la ruta lo incluye, así que no se puede leer la de otra sesión); solo los consultores escriben.
      match /pizarra/{eid} {
        allow get, list: if true;
        allow create, update, delete: if esConsultor() && esIdPz(eid);

        match /partes/{pid} {
          allow get: if true;
          allow list: if false;
          allow create, update: if esConsultor() && pid.matches('^[0-2]_[0-9]$') && partePz(request.resource.data);
          allow delete: if esConsultor();
        }
      }
    }

    // Reunión en vivo: el cliente sigue la pregunta del consultor y puede PROPONER respuestas.
    // El token (192 bits al azar) es el secreto; el enlace vence (venceEn) y el consultor puede cerrarlo (se borra).
    // El cliente NO puede listar, crear ni borrar, y solo puede escribir sus propuestas y la marca de conexión.
    match /en_vivo/{token} {
      function vigente(d) {
        return d.activo == true && d.venceEn > request.time;
      }
      function soloCliente() {
        let cambios = request.resource.data.diff(resource.data).affectedKeys();
        return cambios.hasOnly(['propuestas', 'clienteVisto'])
          && (!('propuestas' in cambios)
              || (request.resource.data.propuestas.size() <= 80
                  && request.resource.data.propuestas.values().hasOnly([0, 1, 2, 3])))
          && (!('clienteVisto' in cambios) || request.resource.data.clienteVisto == request.time);
      }
      function camposConsultor() {
        return request.resource.data.keys().hasOnly(['perfil', 'consultor', 'qid', 'fase', 'respuestas', 'notas', 'total',
          'propuestas', 'clienteVisto', 'activo', 'creadoEn', 'actualizadoEn', 'venceEn'])
          && consultorOk(request.resource.data);
      }
      // El enlace sigue vigente (activo y sin vencer); lo usan la pizarra y las presencias.
      function enlaceVigente() {
        let p = get(/databases/$(database)/documents/en_vivo/$(token)).data;
        return p.activo == true && p.venceEn > request.time;
      }
      allow get: if esConsultor() || vigente(resource.data);
      allow list: if false;
      allow create: if esConsultor() && token.size() == 32 && camposConsultor();
      allow update: if (esConsultor() && camposConsultor()) || (vigente(resource.data) && soloCliente());
      allow delete: if esConsultor();

      // Presencia: cada dispositivo del cliente avisa su nombre y la hora (cada ~25 s) en presentes/{código al azar}.
      // El cliente solo puede escribir (y quitar) su propia presencia con la hora del servidor; solo el consultor las lista.
      match /presentes/{pid} {
        allow get, list: if esConsultor();
        allow create, update: if esIdPz(pid)
          && enlaceVigente()
          && request.resource.data.keys().hasOnly(['n', 'c', 't'])
          && request.resource.data.keys().hasAll(['n', 't'])
          && request.resource.data.n is string && request.resource.data.n.size() >= 1 && request.resource.data.n.size() <= 60
          && (!('c' in request.resource.data) || (request.resource.data.c is string && request.resource.data.c.size() <= 60))
          && request.resource.data.t == request.time;
        // quien sale de la reunión borra su propia presencia (el código de 20 caracteres es suyo y no se puede listar)
        allow delete: if esConsultor() || enlaceVigente();
      }

      // Pizarra en vivo: mientras el enlace está vigente, cualquiera con el token ve los comentarios y puede AGREGAR
      // los suyos (con su nombre). No puede editar ni borrar; el consultor puede borrar cualquiera.
      match /pizarra/{eid} {
        allow get, list: if esConsultor() || enlaceVigente();
        allow create: if esIdPz(eid)
          && comentarioPz(request.resource.data)
          && request.resource.data.creadoEn == request.time
          && (
            (esConsultor()
              && request.resource.data.rol == 'consultor'
              && request.resource.data.email == request.auth.token.email)
            || (request.resource.data.rol == 'cliente'
              && !('email' in request.resource.data)
              && enlaceVigente())
          );
        allow update: if false;
        allow delete: if esConsultor();

        // Contenido de los documentos adjuntos: el cliente y el consultor suben las partes; no se pueden listar ni editar.
        match /partes/{pid} {
          allow get: if esConsultor() || enlaceVigente();
          allow list: if false;
          allow create: if esIdPz(eid) && pid.matches('^[0-2]_[0-9]$') && partePz(request.resource.data) && (esConsultor() || enlaceVigente());
          allow update: if false;
          allow delete: if esConsultor();
        }
      }
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
